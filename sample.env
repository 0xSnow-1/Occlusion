# sample.env — copy to .env and fill in real values. NEVER commit .env.
# Key names match what the code actually reads (os.getenv sites noted below).
# Every line is spaceless KEY=value — spaces around `=` break dotenv parsing.
# Qdrant runs repo-local at ./data/qdrant_storage — no Qdrant Cloud keys needed.
# Bedrock is the only wired generation provider — no alt-provider key is read.

# --- Q&A-only (minimum: scripts/run_agent.py, src/ui/app.py) ---
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_token
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1

# --- API service only (scripts/run_api.py; defaults are safe to omit) ---
# OCCLUSION_API_HOST=0.0.0.0
# OCCLUSION_API_PORT=8000
# OCCLUSION_COLLECTION=occlusion
# OCCLUSION_QDRANT_PATH=./data/qdrant_storage
# OCCLUSION_CONFIDENCE_THRESHOLD=0.7
# OCCLUSION_REQUEST_TIMEOUT_S=30
# OCCLUSION_MAX_QUESTION_LENGTH=1000

# --- Eval only (src/eval/ragas/run_ragas.py reads BEDROCK_JUDGE_MODEL_ID;
# --- bare JUDGE_MODEL_ID is NOT read — do not use it) ---
# BEDROCK_JUDGE_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Observability only (LangSmith SDK reads these directly; repo code does not.
# --- LANGSMITH_TRACING is canonical for the pinned langsmith SDK;
# --- legacy LANGCHAIN_TRACING_V2 is NOT used — do not set both) ---
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=dental-rag-agent

# --- Booking only (V2 receptionist on feature/New-v2; nothing on this line reads these) ---
# CAL_API_KEY=cal_live_...
# CAL_USERNAME=your-cal-username
# CAL_TIMEZONE=UTC
# STAFF_CODE=
