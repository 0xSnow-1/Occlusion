# sample.env — copy to .env and fill in real values. NEVER commit .env.
# Required for: Dental RAG agent MVP (see TODO.md)

# --- Vector DB (Qdrant Cloud free tier) ---
QDRANT_URL=https://your-cluster.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# --- LLM generation provider (pick ONE path for the MVP) ---
# Option A: Anthropic via Bedrock
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_token
BEDROCK_MODEL_ID=your_bedrock_model_id
BEDROCK_REGION=us-east-1
# Option B: Groq (free tier, fast open-weight inference)
GROQ_API_KEY=your_groq_api_key

# --- LLM judge for Ragas (keep DISTINCT from the generator model) ---
JUDGE_MODEL_ID=your_judge_model_id

# --- Observability (LangSmith) ---
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=dental-rag-agent
LANGCHAIN_TRACING_V2=true

# --- Not needed for the MVP (left here so you know they exist) ---
# GOOGLE_API_KEY=       # alt generation provider
# TAVILY_API_KEY=       # web search (not used in v1)
# DB_URI= / POSTGRES_URI=  # only if you add LangGraph checkpointing
